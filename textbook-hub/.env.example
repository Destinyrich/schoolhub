# Database (SQLite for local/low-budget dev; swap to Postgres URL in production)
DATABASE_URL="file:./dev.db"

# NextAuth (admin login sessions)
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# JWT used to sign student "access tokens" after a successful purchase
ACCESS_TOKEN_SECRET="replace-with-another-long-random-string"

# Paystack (get these from your Paystack dashboard: https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Google AdSense (optional, fill in once approved — leave blank to hide ad slots)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
